<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>sh.atuin.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{home}}/.nix-profile/bin/atuin</string>
		<string>daemon</string>
		<string>start</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>XDG_CONFIG_HOME</key>
		<string>{{home}}/.config</string>
		<key>XDG_DATA_HOME</key>
		<string>{{home}}/.local/share</string>
		<key>XDG_RUNTIME_DIR</key>
		<string>{{home}}/.local/run</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>{{home}}/.atuin</string>
	<key>StandardErrorPath</key>
	<string>{{home}}/.atuin/logs/daemon.stderr.log</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>Crashed</key>
		<true/>
	</dict>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
