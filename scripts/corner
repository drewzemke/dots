#!/usr/bin/env nu
# put a message in the top corner of the zjstatus bar
# zellij pipe can hang forever and spin a core, so cap it
def pipe-with-timeout [payload: string, limit: duration = 2sec] {
  let id = job spawn { ^zellij pipe $payload }
  let deadline = (date now) + $limit
  while ((job list | where id == $id | is-not-empty) and ((date now) < $deadline)) {
    sleep 50ms
  }
  try { job kill $id }
}

def main [input?: string] {
  let msg = $input | default --empty $in

  if ($msg | is-not-empty) {
    pipe-with-timeout $"zjstatus::pipe::pipe_corner::($msg)"
  }
}
